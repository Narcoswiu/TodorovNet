# Copy to .env.local. Local values come from `npx supabase status`.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Shown on the privacy page as the data contact. Required before going live.
# The Supabase project must be created in an EU region (Frankfurt); vercel.json pins functions to fra1.
NEXT_PUBLIC_OPERATOR_NAME=
NEXT_PUBLIC_CONTACT_EMAIL=
